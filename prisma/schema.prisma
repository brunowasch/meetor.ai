generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model authorized_domains {
  id          String    @id @db.VarChar(36)
  customer_id String    @db.VarChar(36)
  domain      String    @db.VarChar(100)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "authorized_domains_ibfk_1")

  @@index([customer_id], map: "customer_id")
}

model customer_addresses {
  id          String    @id @db.VarChar(36)
  customer_id String    @db.VarChar(36)
  street      String    @db.VarChar(100)
  number      String    @db.VarChar(20)
  complement  String?   @db.VarChar(100)
  district    String    @db.VarChar(100)
  city        String    @db.VarChar(100)
  state       String    @db.Char(2)
  zip_code    String    @db.VarChar(9)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_addresses_ibfk_1")

  @@index([customer_id], map: "customer_id")
}

model customers {
  id                 String               @id @db.VarChar(36)
  name               String               @db.VarChar(100)
  cnpj               String               @unique(map: "cnpj") @db.VarChar(18)
  sla_response       Int                  @default(30)
  sla_resolution     Int                  @default(24)
  created_at         DateTime?            @default(now()) @db.Timestamp(0)
  updated_at         DateTime?            @default(now()) @db.Timestamp(0)
  authorized_domains authorized_domains[]
  customer_addresses customer_addresses[]
  departments        departments[]
  tickets            tickets[]
  users              users[]
}

model departments {
  id          String    @id @db.VarChar(36)
  customer_id String    @db.VarChar(36)
  name        String    @db.VarChar(100)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "departments_ibfk_1")
  tickets     tickets[]
  users       users[]

  @@index([customer_id], map: "customer_id")
}

model employees {
  id         String          @id @db.VarChar(36)
  name       String          @db.VarChar(100)
  email      String          @unique(map: "email") @db.VarChar(100)
  phone      String          @db.VarChar(15)
  position   String          @db.VarChar(100)
  level      employees_level
  hire_date  DateTime        @db.Date
  created_at DateTime?       @default(now()) @db.Timestamp(0)
  updated_at DateTime?       @default(now()) @db.Timestamp(0)
  tickets    tickets[]
}

model experience_enrollments {
  id       Int @id @default(autoincrement()) @db.UnsignedInt
  userid   Int @db.UnsignedInt
  courseid Int @db.UnsignedInt
  enrolled Int @default(1) @db.UnsignedTinyInt
}

model experience_users {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  dtreg        DateTime @db.DateTime(0)
  name         String   @db.VarChar(64)
  email        String   @db.VarChar(128)
  phone        String   @db.VarChar(16)
  neighborhood String   @db.VarChar(64)
  city         String   @db.VarChar(64)
  state        String   @db.VarChar(2)
  birthday     DateTime @db.Date
  gender       String   @db.VarChar(12)
  scholarity   String   @db.VarChar(12)
  avatarid     String   @default("generic") @db.VarChar(20)
  cpf          String   @db.VarChar(20)
  ans1         String   @default("-") @db.Char(1)
  ans2         String   @default("-") @db.Char(1)
  ans3         String   @default("-") @db.Char(1)
  ans4         String   @default("-") @db.Char(1)
  ans5         String   @default("-") @db.Char(1)
  ans6         String   @default("-") @db.Char(1)
  ans7         String   @default("-") @db.Char(1)
  ans8         String   @default("-") @db.Char(1)
  ans9         String   @default("-") @db.Char(1)
  ans10        String   @default("-") @db.Char(1)
  ans11        String   @default("-") @db.Char(1)
  ans12        String   @default("-") @db.Char(1)
}

model experience_words {
  id      Int      @id @default(autoincrement()) @db.UnsignedInt
  word    String   @db.VarChar(32)
  count   Int      @default(1)
  dtfirst DateTime @db.DateTime(0)
  dtlast  DateTime @db.DateTime(0)
}

model questions {
  id       Int    @id @default(autoincrement()) @db.UnsignedInt
  storyid  Int    @db.UnsignedInt
  question String @db.VarChar(256)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model stories {
  id      Int
  title   String        @db.VarChar(128)
  genre   stories_genre
  grade   Int           @db.UnsignedInt
  content String        @db.Text

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model test {
  id   Int?
  name String? @db.VarChar(256)

  @@ignore
}

model ticket_attachments {
  id          String    @id @db.VarChar(36)
  ticket_id   String    @db.VarChar(36)
  name        String    @db.VarChar(255)
  url         String    @db.VarChar(255)
  size        Int
  type        String    @db.VarChar(100)
  uploaded_at DateTime? @default(now()) @db.Timestamp(0)
  tickets     tickets   @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ticket_attachments_ibfk_1")

  @@index([ticket_id], map: "ticket_id")
}

model ticket_history {
  id         String              @id @db.VarChar(36)
  ticket_id  String              @db.VarChar(36)
  type       ticket_history_type
  content    String              @db.Text
  user_id    String              @db.VarChar(36)
  metadata   Json?
  created_at DateTime?           @default(now()) @db.Timestamp(0)
  tickets    tickets             @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ticket_history_ibfk_1")
  users      users               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ticket_history_ibfk_2")

  @@index([ticket_id], map: "ticket_id")
  @@index([user_id], map: "user_id")
}

model tickets {
  id                 String                 @id @db.VarChar(36)
  type               tickets_type
  title              String                 @db.VarChar(200)
  description        String                 @db.Text
  customer_id        String                 @db.VarChar(36)
  department_id      String                 @db.VarChar(36)
  priority           tickets_priority
  sla                tickets_sla
  status             tickets_status
  service_status     tickets_service_status
  justification      String?                @db.Text
  assigned_to_id     String?                @db.VarChar(36)
  created_by_id      String                 @db.VarChar(36)
  created_at         DateTime?              @default(now()) @db.Timestamp(0)
  updated_at         DateTime?              @default(now()) @db.Timestamp(0)
  closed_at          DateTime?              @db.Timestamp(0)
  ticket_attachments ticket_attachments[]
  ticket_history     ticket_history[]
  customers          customers              @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "tickets_ibfk_1")
  departments        departments            @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "tickets_ibfk_2")
  employees          employees?             @relation(fields: [assigned_to_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "tickets_ibfk_3")
  users              users                  @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "tickets_ibfk_4")

  @@index([assigned_to_id], map: "assigned_to_id")
  @@index([created_by_id], map: "created_by_id")
  @@index([customer_id], map: "customer_id")
  @@index([department_id], map: "department_id")
}

model users {
  id             String           @id @db.VarChar(36)
  name           String           @db.VarChar(100)
  email          String           @unique(map: "email") @db.VarChar(100)
  phone          String           @db.VarChar(15)
  role           users_role
  customer_id    String?          @db.VarChar(36)
  department_id  String?          @db.VarChar(36)
  created_at     DateTime?        @default(now()) @db.Timestamp(0)
  updated_at     DateTime?        @default(now()) @db.Timestamp(0)
  ticket_history ticket_history[]
  tickets        tickets[]
  customers      customers?       @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_ibfk_1")
  departments    departments?     @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_ibfk_2")

  @@index([customer_id], map: "customer_id")
  @@index([department_id], map: "department_id")
}

enum tickets_type {
  request
  incident
}

enum stories_genre {
  Fantasy
  Mistery
  Detective
  Horror
  History
  Daily_Life @map("Daily Life")
  Other
}

enum ticket_history_type {
  status_change @map("status-change")
  comment
  field_update  @map("field-update")
  attachment
}

enum users_role {
  super
  admin
  operator
}

enum employees_level {
  junior
  pleno
  senior
}

enum tickets_priority {
  urgent
  medium
  low
  very_low @map("very-low")
}

enum tickets_sla {
  basic
  advanced
  premium
}

enum tickets_status {
  open
  in_progress @map("in-progress")
  closed
}

enum tickets_service_status {
  backlog
  review
  in_progress @map("in-progress")
  pending
  completed
  cancelled
}

model mentorconnect_usuario {
  id              String                     @id @default(uuid()) @db.VarChar(36)
  usuario_id      String                     @unique @db.VarChar(255)
  email           String                     @db.VarChar(255)
  senha           String?                    @db.VarChar(255)
  nome            String?                    @db.VarChar(255)
  sobrenome       String?                    @db.VarChar(255)
  tipo            mentorconnect_usuario_tipo
  foto_perfil     String?                    @db.Text
  cidade          String?                    @db.VarChar(255)
  estado          String?                    @db.VarChar(255)
  pais            String?                    @db.VarChar(255)
  bio_descricao   String?                    @db.Text
  sincronizado_em DateTime                   @default(now())
  atualizado_em   DateTime                   @updatedAt
  reunioes        mentorconnect_reuniao[]
}

model mentorconnect_reuniao {
  id           String                        @id @default(uuid()) @db.VarChar(36)
  token        String                        @unique @db.VarChar(64)
  titulo       String?                       @db.VarChar(255)
  criado_por   String                        @db.VarChar(255)
  status       mentorconnect_reuniao_status  @default(ativa)
  link         String                        @db.VarChar(512)
  criado_em    DateTime                      @default(now())
  atualizado_em DateTime                     @updatedAt
  usuario      mentorconnect_usuario         @relation(fields: [criado_por], references: [usuario_id], onDelete: Cascade, onUpdate: Cascade)

  @@index([criado_por], map: "reuniao_criado_por_idx")
}

enum mentorconnect_reuniao_status {
  ativa
  encerrada
  cancelada
}

enum mentorconnect_usuario_tipo {
  candidato
  mentor
}